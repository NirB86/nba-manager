{
  "name": "nba-manager",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "description": "Basketball franchise management game (working title).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "import:fetch": "NODE_USE_ENV_PROXY=1 tsx tools/import-real/fetch.ts",
    "import:build": "tsx tools/import-real/build.ts",
    "import:images": "NODE_USE_ENV_PROXY=1 tsx tools/import-real/images.ts",
    "import:images-more": "NODE_USE_ENV_PROXY=1 tsx tools/import-real/images-more.ts",
    "import:publish": "NODE_USE_ENV_PROXY=1 tsx tools/import-real/publish.ts",
    "import:coaches": "NODE_USE_ENV_PROXY=1 tsx tools/import-real/coaches.ts",
    "import:official": "NODE_USE_ENV_PROXY=1 tsx tools/import-real/official.ts",
    "import:cities": "NODE_USE_ENV_PROXY=1 tsx tools/import-real/cities.ts",
    "import:arenas": "NODE_USE_ENV_PROXY=1 tsx tools/import-real/arenas.ts",
    "import:faces": "NODE_USE_ENV_PROXY=1 tsx tools/import-real/faces.ts",
    "import:images-nc": "NODE_USE_ENV_PROXY=1 tsx tools/import-real/images-nc.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "idb": "8.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "@vladmandic/face-api": "1.7.15",
    "node-html-parser": "9.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12"
  }
